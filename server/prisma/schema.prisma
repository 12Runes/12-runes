generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Match {
  id     String @id @default(uuid())
  gameName String @default("Riftbound")

  startedAt DateTime
  endedAt   DateTime?

  result    String // WIN | LOSS | UNKNOWN

  // Id anónimo generado y guardado por cada instalación de la extensión (no identifica a
  // la persona). Permite separar "mis partidas" de las de todo el mundo una vez el backend
  // sea compartido entre varias instalaciones. Null en partidas guardadas antes de esto.
  contributorId String?

  // Agrupa las partidas de un mismo Bo3 (misma conexión WebRTC entre los dos jugadores);
  // gameNumber es el 1/2/3 dentro de esa serie. Null/1 en partidas sueltas o anteriores a esto.
  seriesId   String?
  gameNumber Int?

  turnCount  Int?
  onThePlay  Boolean? // true = empezó la partida, false = segundo, null = no se pudo determinar

  localPlayerId    String?
  localPseudo      String?
  opponentPlayerId String?
  opponentPseudo   String?

  localLegendId       String?
  localLegendName     String?
  opponentLegendId    String?
  opponentLegendName  String?

  // Código de set/expansión activo cuando se jugó (p. ej. "VEN" = Vendetta), derivado de las
  // banderas `_legal` que trae cada carta del mazo (ver extension/parser.js). Es una propiedad
  // de la sala, igual para los dos lados. Null en partidas grabadas antes de esta función, o si
  // el mazo capturado no traía esa información.
  season String?

  // SQLite no tiene tipo Json nativo en Prisma; se guardan como texto serializado
  // (portable a Postgres más adelante, donde sí se podría pasar a Json real).
  localDeck    String?
  opponentDeck String?
  events       String

  // Battlefield(s) en juego de cada lado durante esta partida concreta (viene de
  // `playerData.visibleCards`, no del mazo — el mazo trae el pool completo de candidatos, esto
  // es cuál se jugó de verdad). Array de {cardId, cardName, cardImage} serializado; puede haber
  // más de uno. Null en partidas grabadas antes de esta función.
  localBattlefields    String?
  opponentBattlefields String?

  // Cartas jugadas por cada lado en esta partida, ya extraídas de `events` una sola vez al
  // guardar la partida (ver extractCardsPlayed en stats.ts) — evita tener que volver a parsear
  // el log completo en cada lectura de /stats/cards o /stats/card-grades. Array de
  // {cardId, cardName, cardType, cardImage, timesPlayed} serializado. Null si no se jugó
  // ninguna carta identificable, o en partidas grabadas antes de esta función (se rellena solo
  // al arrancar el servidor — ver el backfill en index.ts).
  localCardsPlayed    String?
  opponentCardsPlayed String?

  // Huella de la partida real (hash del contenido de `events` que viene del propio motor del
  // juego: id/playerId/timestamp de cada jugada — igual para los dos jugadores, a diferencia
  // de `seriesId`/`startedAt` que cada instalación genera por su cuenta). Si los dos jugadores
  // de una partida le dan a "Grabar", la segunda subida cae en la misma huella que la primera
  // y no se duplica (ver `computeMatchFingerprint` en stats.ts). Null si `events` viene vacío
  // (partida sin ninguna jugada registrada) o en partidas grabadas antes de esta función.
  matchFingerprint String? @unique

  createdAt DateTime @default(now())

  @@index([localLegendName])
  @@index([opponentLegendName])
  @@index([result])
  @@index([contributorId])
  @@index([seriesId])
  @@index([season])
}
